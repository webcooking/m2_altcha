<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            The ALTCHA hidden input must live inside the subscribe <form>, so the
            subscribe template is overridden (reCAPTCHA's footer-container trick
            relies on a JS DOM move, which does not apply to a self-contained field).
        -->
        <referenceBlock name="form.subscribe">
            <action method="setTemplate" ifconfig="altcha/frontend_forms/newsletter">
                <argument name="template" xsi:type="string">Webcooking_Altcha::newsletter/subscribe.phtml</argument>
            </action>
            <block class="Magento\Framework\View\Element\Template" name="altcha.newsletter" as="altcha" template="Webcooking_Altcha::altcha.phtml" ifconfig="altcha/frontend_forms/newsletter">
                <arguments>
                    <argument name="view_model" xsi:type="object">Webcooking\Altcha\ViewModel\Widget</argument>
                    <argument name="altcha_for" xsi:type="string">newsletter</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template" name="altcha.assets.newsletter" as="altcha_assets" template="Webcooking_Altcha::loader.phtml" ifconfig="altcha/frontend_forms/newsletter"/>
        </referenceBlock>
    </body>
</page>
