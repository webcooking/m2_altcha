<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="form.additional.review.info">
            <block class="Magento\Framework\View\Element\Template" name="altcha.product.review" template="Webcooking_Altcha::altcha.phtml" ifconfig="altcha/frontend_forms/product_review">
                <arguments>
                    <argument name="view_model" xsi:type="object">Webcooking\Altcha\ViewModel\Widget</argument>
                    <argument name="altcha_for" xsi:type="string">product_review</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template" name="altcha.assets.product.review" template="Webcooking_Altcha::loader.phtml" ifconfig="altcha/frontend_forms/product_review"/>
        </referenceContainer>
    </body>
</page>
